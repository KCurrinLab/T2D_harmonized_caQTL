params {
	genome = "hg38"
	exclude_regions = "${projectDir}/files/ENCFF356LFX.bed.gz"
	chrom_sizes = "${projectDir}/files/hg38.chrom.sizes"
	primary_nuclear_chr = "${projectDir}/files/hg38_primary_nuclear_chr.bed"
	macs_genome = "hs"
	min_samples = "3"
	get_reproducible_peaks = "yes"
	summit_extend = "150"
}

process {

	executor = 'slurm'
	cpus = 1
	memory = '32GB'
	time = '1d'

	withName: 'filterBam' {
		cpus = 10
		memory = '100GB'
	}

	container = "${projectDir}/dependencies.sif"
}

apptainer {
	enabled = true
	autoMounts = true
}
